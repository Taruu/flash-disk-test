#!/usr/bin/env bash
# flash-test — Single Flash Drive QA (run one instance per stick)
set -euo pipefail

FLASH_TEST_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/safety.sh
source "$FLASH_TEST_ROOT/lib/safety.sh"
# shellcheck source=lib/detector.sh
source "$FLASH_TEST_ROOT/lib/detector.sh"
# shellcheck source=lib/selection.sh
source "$FLASH_TEST_ROOT/lib/selection.sh"
# shellcheck source=lib/reporter.sh
source "$FLASH_TEST_ROOT/lib/reporter.sh"
# shellcheck source=lib/tests/test_fake.sh
source "$FLASH_TEST_ROOT/lib/tests/test_fake.sh"
# shellcheck source=lib/tests/test_surface.sh
source "$FLASH_TEST_ROOT/lib/tests/test_surface.sh"
# shellcheck source=lib/tests/test_speed.sh
source "$FLASH_TEST_ROOT/lib/tests/test_speed.sh"
# shellcheck source=lib/tests/test_format.sh
source "$FLASH_TEST_ROOT/lib/tests/test_format.sh"
# shellcheck source=lib/runner.sh
source "$FLASH_TEST_ROOT/lib/runner.sh"
# shellcheck source=lib/tui.sh
source "$FLASH_TEST_ROOT/lib/tui.sh"

usage() {
  cat <<'EOF'
flash-test — Single Flash Drive QA

Tests ONE removable drive per process. Run multiple terminals/instances
yourself to test several sticks in parallel (use a different --state-file
per instance so each remembers its own UUID).

Usage:
  flash-test                          Interactive: pick one drive
  flash-test --interactive
  flash-test --use-saved              Reuse last saved UUID/drive
  flash-test --show-selection         Print saved UUID and exit
  flash-test --clear-selection        Clear saved selection
  flash-test /dev/sdb                 Test this device
  flash-test --non-destructive /dev/sde
  flash-test --allow-loop /dev/loop0

Options:
  --mode MODE           quick (default) | full | non-destructive
  --format FS           exfat (default) | vfat | ext4 | none
  --yes-format          Required for non-interactive formatting
  --output DIR          Report directory (default: ./reports/<uuid>/<timestamp>)
  --state-file PATH     Where to save this instance's drive selection
  --allow-loop          Allow losetup loop devices
  --list                List safe removable targets (with UUID)
  --timeout-fake SEC    Default 1800
  --timeout-surface SEC Default 21600
  --timeout-speed SEC   Default 1800
  --timeout-format SEC  Default 600
  -h, --help            Show this help

Selection is saved under ./state/selected.conf (or --state-file).
The TUI shows and restores the selected UUID on the next launch.
EOF
}

main() {
  local interactive=0
  local use_saved=0
  local list_only=0
  local show_sel=0
  local clear_sel=0
  local allow_loop=0
  local yes_format=0
  local mode="quick"
  local format="exfat"
  local output=""
  local user_dev=""

  FLASH_TEST_TIMEOUT_FAKE=1800
  FLASH_TEST_TIMEOUT_SURFACE=21600
  FLASH_TEST_TIMEOUT_SPEED=1800
  FLASH_TEST_TIMEOUT_FORMAT=600
  FLASH_TEST_FORMAT_CONFIRMED=0
  FLASH_TEST_FORMAT_OUTCOME_NOTE=""

  if (($# == 0)); then
    interactive=1
  fi

  while (($# > 0)); do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --interactive) interactive=1; shift ;;
      --use-saved) use_saved=1; shift ;;
      --show-selection) show_sel=1; shift ;;
      --clear-selection) clear_sel=1; shift ;;
      --list) list_only=1; shift ;;
      --allow-loop) allow_loop=1; shift ;;
      --yes-format) yes_format=1; shift ;;
      --state-file)
        FLASH_TEST_STATE_FILE="$2"
        shift 2
        ;;
      --non-destructive)
        mode="non-destructive"
        shift
        if (($# > 0)) && [[ "$1" != -* ]]; then
          user_dev="$1"; shift
        fi
        ;;
      --mode)
        mode="$2"; shift 2
        case "$mode" in
          quick|full|non-destructive) ;;
          *) echo "error: invalid --mode $mode" >&2; exit 2 ;;
        esac
        ;;
      --format)
        format="$2"; shift 2
        case "$format" in
          exfat|vfat|fat32|ext4|none) ;;
          *) echo "error: invalid --format $format" >&2; exit 2 ;;
        esac
        [[ "$format" == "fat32" ]] && format="vfat"
        ;;
      --output) output="$2"; shift 2 ;;
      --timeout-fake) FLASH_TEST_TIMEOUT_FAKE="$2"; shift 2 ;;
      --timeout-surface) FLASH_TEST_TIMEOUT_SURFACE="$2"; shift 2 ;;
      --timeout-speed) FLASH_TEST_TIMEOUT_SPEED="$2"; shift 2 ;;
      --timeout-format) FLASH_TEST_TIMEOUT_FORMAT="$2"; shift 2 ;;
      --quick)
        mode="quick"
        shift
        if (($# > 0)) && [[ "$1" != -* ]]; then
          user_dev="$1"; shift
        fi
        ;;
      -*)
        echo "error: unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
      *)
        if [[ -n "$user_dev" ]]; then
          echo "error: only one device allowed (got extra: $1)" >&2
          exit 2
        fi
        user_dev="$1"
        shift
        ;;
    esac
  done

  if [[ $clear_sel -eq 1 ]]; then
    selection_clear
    echo "Cleared selection at $(selection_path)"
    exit 0
  fi

  if [[ $show_sel -eq 1 ]]; then
    selection_print "Saved"
    exit 0
  fi

  require_root
  FLASH_TEST_FORMAT="$format"
  FLASH_TEST_ALLOW_LOOP="$allow_loop"

  if [[ $list_only -eq 1 ]]; then
    echo "Safe removable targets:"
    local line
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local by_id resolved serial vendor model size_b size_h usb uuid
      IFS='|' read -r by_id resolved serial vendor model size_b size_h usb uuid <<<"$line"
      printf '  UUID=%-24s  %-12s  %8s  %s %s\n' "$uuid" "$(basename "$resolved")" "$size_h" "$vendor" "$model"
    done < <(enumerate_removable_drives "$allow_loop")
    echo ""
    selection_print "Saved" || true
    exit 0
  fi

  check_dependencies

  local meta=""

  if [[ $interactive -eq 1 && -z "$user_dev" && $use_saved -eq 0 ]]; then
    local pick_out
    pick_out="$(mktemp)"
    if ! tui_pick_drive "$allow_loop" >"$pick_out"; then
      rm -f "$pick_out"
      echo "No drive selected / quit." >&2
      exit 1
    fi
    meta="$(cat "$pick_out")"
    rm -f "$pick_out"
  elif [[ $use_saved -eq 1 ]]; then
    if ! selection_load; then
      echo "error: no saved selection (run interactively first)" >&2
      exit 1
    fi
    echo "Using saved selection:" >&2
    selection_print "Saved" >&2
    meta="$(find_drive_by_saved "$allow_loop" "${SELECTION_UUID:-}" "${SELECTION_BY_ID:-}")" || {
      echo "error: saved UUID ${SELECTION_UUID:-?} is not plugged in" >&2
      exit 1
    }
    selection_save "$meta"
  elif [[ -n "$user_dev" ]]; then
    meta="$(resolve_one_target "$allow_loop" "$user_dev")" || {
      echo "error: invalid / unsafe target: $user_dev" >&2
      exit 1
    }
    selection_save "$meta"
  else
    echo "error: pass a device, --use-saved, or run with no args for the TUI" >&2
    exit 2
  fi

  [[ -n "$meta" ]] || { echo "error: no target" >&2; exit 1; }

  local by_id resolved serial vendor model size_b size_h usb uuid
  IFS='|' read -r by_id resolved serial vendor model size_b size_h usb uuid <<<"$meta"

  echo "" >&2
  echo "Selected UUID: $uuid" >&2
  echo "         device: $resolved  serial: $serial  $size_h" >&2
  echo "         saved → $(selection_path)" >&2
  echo "" >&2

  if [[ "$mode" != "non-destructive" ]]; then
    print_destructive_banner >&2
    echo "Mode: $mode  Format: $FLASH_TEST_FORMAT" >&2
    echo "" >&2
  fi

  if [[ -t 0 ]]; then
    tui_confirm_format "$FLASH_TEST_FORMAT" "$meta" || exit 1
  else
    cli_confirm_format "$FLASH_TEST_FORMAT" "$yes_format" || exit 1
  fi
  format="$FLASH_TEST_FORMAT"

  if [[ -z "$output" ]]; then
    local safe
    safe="$(echo "$uuid" | tr -c 'A-Za-z0-9._-' '_')"
    output="$FLASH_TEST_ROOT/reports/${safe}/$(date +%Y%m%dT%H%M%S)"
  fi
  mkdir -p "$output"
  echo "Reports → $output" >&2

  local batch_rc=0
  (
    runner_run_one "$meta" "$output" "$mode" "$format"
  ) >/dev/null 2>&1 &
  local worker_pid=$!

  tui_live_one "$output" "$worker_pid" "$uuid"
  wait "$worker_pid" || batch_rc=$?

  if [[ -n "$FLASH_TEST_FORMAT_OUTCOME_NOTE" ]]; then
    local sf
    for sf in "$output"/*.status; do
      [[ -f "$sf" ]] || continue
      local fo
      fo="$(reporter_get "$sf" format_outcome)"
      if [[ -z "$fo" || "$fo" == "none" ]]; then
        reporter_set_status "$sf" format_outcome "$FLASH_TEST_FORMAT_OUTCOME_NOTE"
      fi
    done
    mapfile -t _sfs < <(find "$output" -maxdepth 1 -name '*.status' | sort)
    if ((${#_sfs[@]})); then
      reporter_write_summary "$output" "${_sfs[@]}"
    fi
  fi

  echo ""
  echo "Selected UUID: $uuid"
  local sf result
  sf="$(find "$output" -maxdepth 1 -name '*.status' | sort | tail -n1 || true)"
  if [[ -n "$sf" ]]; then
    result="$(reporter_get "$sf" result)"
    echo "Result: $result"
    echo "Log:    $(reporter_get "$sf" log)"
  fi
  echo "Summary: $output/summary.json"
  selection_print "Saved"

  if [[ $batch_rc -ne 0 ]]; then
    exit 1
  fi
  [[ "${result:-}" == "PASSED" ]] || exit 1
  exit 0
}

main "$@"
