#!/usr/bin/env bash
# flash-test — Simple one-drive flash QA (TUI)
set -euo pipefail

FLASH_TEST_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/safety.sh
source "$FLASH_TEST_ROOT/lib/safety.sh"
# shellcheck source=lib/detect.sh
source "$FLASH_TEST_ROOT/lib/detect.sh"
# shellcheck source=lib/run.sh
source "$FLASH_TEST_ROOT/lib/run.sh"
# shellcheck source=lib/tui.sh
source "$FLASH_TEST_ROOT/lib/tui.sh"

usage() {
  cat <<'EOF'
flash-test — Simple one-drive flash tester

Pipeline (one stick per run):
  SMART preflight (optional long self-test → exit & re-run)
  smartctl -a → f3probe --destructive → badblocks -wsv → hdparm → mkfs.exfat → fsck

If the disk supports SMART self-tests, you can start a long offline test;
flash-test exits and you re-run later to read the result before destructive steps.

Usage:
  flash-test              Interactive TUI: pick one drive
  flash-test --list       List safe removable targets
  flash-test --help

Logs:
  logs/<uuid>/<YYYYMMDDTHHMMSS>.log
  logs/<uuid>/smart-*.log
  logs/<uuid>/smart-selftest.state   (while a self-test is pending)
EOF
}

main() {
  case "${1:-}" in
    -h|--help)
      usage
      exit 0
      ;;
    --list)
      list_drives_human
      exit 0
      ;;
    "")
      ;;
    *)
      echo "error: unknown argument: $1 (this app is TUI-only; use --list or --help)" >&2
      usage >&2
      exit 2
      ;;
  esac

  require_root
  check_dependencies

  local meta
  if ! meta="$(tui_pick_drive)"; then
    echo "Aborted (no drive selected)." >&2
    exit 1
  fi
  [[ -n "$meta" ]] || { echo "error: empty selection" >&2; exit 1; }

  local by_id resolved serial vendor model size_b size_h usb uuid
  IFS='|' read -r by_id resolved serial vendor model size_b size_h usb uuid <<<"$meta"

  # SMART first: dump health; optionally arm self-test and exit for next run
  local smart_rc=0
  smart_preflight "$meta" || smart_rc=$?
  case "$smart_rc" in
    0) ;;
    10)
      echo "Exiting so the SMART self-test can finish. Re-run when done." >&2
      exit 0
      ;;
    11)
      echo "Exiting: SMART self-test still in progress." >&2
      exit 0
      ;;
    *)
      echo "SMART preflight failed (rc=$smart_rc) — aborting." >&2
      exit "$smart_rc"
      ;;
  esac

  if ! tui_confirm_destructive "$meta"; then
    echo "Aborted." >&2
    exit 1
  fi

  local do_format
  do_format="$(tui_confirm_format "$meta")"

  local rc=0
  run_pipeline_fg "$meta" "$do_format" || rc=$?

  local result
  result="$(_step_get "$FLASH_TEST_STEP_FILE" result)"
  echo "" >&2
  echo "Result: ${result:-?}  (exit $rc)" >&2
  echo "Log:    $FLASH_TEST_LOG" >&2
  exit "$rc"
}

main "$@"
